# Base URL the frontend calls for the API. In dev, Vite proxies /api to
# VITE_API_PROXY_TARGET (see vite.config.ts), so this can stay relative.
VITE_API_BASE_URL=/api/v1

# Where the dev server proxy forwards /api requests — point at your local
# awms-backend instance (see ../awms-backend/README.md).
VITE_API_PROXY_TARGET=http://localhost:3000
