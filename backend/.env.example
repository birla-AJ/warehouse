NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://awms:awms_password@localhost:5432/awms?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"

# 32-byte hex key for encrypting sensitive fields (Aadhaar, bank account numbers) at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-a-64-char-hex-string"

CORS_ORIGIN="http://localhost:5173"

# Base URL of the frontend app — used to build the password reset link sent by email
APP_URL="http://localhost:5173"

# AWS S3 — required only for Documents presigned upload URLs (POST /documents/upload-url)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="awms-documents"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Used only by the seed script for the bootstrap Super Admin account
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Shared secret for verifying signed webhooks from camera/NVR hardware or the
# health-check worker (see WebhookSignatureGuard for the header contract).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_HMAC_SECRET="replace-with-a-long-random-secret"

# Logging
LOG_LEVEL="info"
